!/src/**/*.cjs
!/src/**/*.mjs
!/src/**/*.css
!/src/**/*.html
!/test/
/test/**
!/test/**/*.cjs
!/test/fixtures/
/test/fixtures/**
!/test/fixtures/regex-compatibility.json

