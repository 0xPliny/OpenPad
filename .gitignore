# Deny new root content unless explicitly reviewed as public source.
/*
!/.gitignore
!/README.md
!/LICENSE
!/package.json
!/package-lock.json
!/package-app.mjs
!/installer.nsh
!/register-local.ps1
!/src/
/src/**
!/src/**/*.js
!/src/**/*.cjs
!/src/**/*.mjs
!/src/**/*.css
!/src/**/*.html
!/test/
/test/**
!/test/**/*.cjs
!/test/fixtures/
/test/fixtures/**
!/test/fixtures/regex-compatibility.json

# Installed dependencies, generated output, and local Git databases.
node_modules/
.git
.git/
dist/
build/
release/
coverage/
test-artifacts/
artifacts/
backups/
state/
profiles/
.cache/
.npm/
.pnpm-store/
*.log
*.tmp
*.bak
*.zip
*.exe
*.asar

# Local editors, agent tools, prompts, conversations, and memory.
.cursor/
.claude/
.codex/
.agents/
.agent/
.ai/
.aiwg/
.aider*
.continue/
.cline/
.roo/
.windsurf/
.gemini/
.copilot/
.opencode/
.hermes/
.grok/
.vscode/
.idea/
.mcp.json
mcp.json
*.code-workspace
*[Pp][Rr][Oo][Mm][Pp][Tt]*
*[Tt][Rr][Aa][Nn][Ss][Cc][Rr][Ii][Pp][Tt]*
*[Cc][Oo][Nn][Vv][Ee][Rr][Ss][Aa][Tt][Ii][Oo][Nn]*
chat-history*
session-history*
*.jsonl
*.local.*
.cursorrules
.cursorignore
.clinerules*
.windsurfrules
.github/copilot-instructions.md

# Instruction and memory Markdown are excluded at every depth.
*.[Mm][Dd]
!/README.md
[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
[Aa][Gg][Ee][Nn][Tt][Ss].*.[Mm][Dd]
[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]
[Cc][Oo][Dd][Ee][Xx].[Mm][Dd]
[Gg][Ee][Mm][Ii][Nn][Ii].[Mm][Dd]
[Ss][Kk][Ii][Ll][Ll].[Mm][Dd]
[Mm][Ee][Mm][Oo][Rr][Yy].[Mm][Dd]

# Credentials and machine-specific settings are never public fixtures.
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*id_rsa*
*id_ed25519*
credentials*
secrets*
